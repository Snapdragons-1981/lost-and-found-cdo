# Environment Variables
# Copy this file to .env and fill in the values

# ==============================
# Database
# ==============================
DATABASE_URL="postgresql://user:password@localhost:5432/lost_and_found_cdo"

# ==============================
# Authentication (Clerk)
# ==============================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ==============================
# Google Maps
# ==============================
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaxxxxxxxx

# ==============================
# Cloudinary
# ==============================
CLOUDINARY_CLOUD_NAME=xxxxxxx
CLOUDINARY_API_KEY=xxxxxxx
CLOUDINARY_API_SECRET=xxxxxxx

# ==============================
# App Config
# ==============================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Lost & Found CDO"
NEXT_PUBLIC_APP_DESCRIPTION="Helping Cagayan de Oro reunite people with what matters."

# ==============================
# Email (Optional)
# ==============================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=xxxxxxx
SMTP_PASS=xxxxxxx
EMAIL_FROM=noreply@lostfoundcdo.ph

# ==============================
# SMS (Optional - Future)
# ==============================
TWILIO_ACCOUNT_SID=xxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxx
TWILIO_PHONE_NUMBER=xxxxxxx
